# Copy this file to .env and fill in real values. Never commit .env.
#
# This site currently ships as static HTML/CSS/JS with no build step and no
# server-side code, so nothing here is required yet. It's here so API keys
# have a home the moment any of the following gets wired up:

# Contact form submission (e.g. Formspree, Resend, SendGrid, a serverless function)
CONTACT_FORM_API_KEY=
CONTACT_FORM_ENDPOINT=

# Analytics (e.g. Plausible, Fathom, GA4)
ANALYTICS_ID=

# Any future backend/API base URL
API_BASE_URL=
